# Phala CVM TODO App Template Configuration
# Copy this to .env and update with your values

# ===== Database Configuration =====
DB_USER=cvm_user
DB_PASSWORD=change_me_to_strong_password
DB_PORT=5432

# ===== Security =====
API_KEY=your-secret-api-key-here-change-me
ENCRYPTION_KEY=your-encryption-key-base64-encoded
JWT_SECRET=generate-a-long-random-value-for-jwt-signing
WEB_SECRET_KEY=generate-a-different-long-random-value-for-flask-sessions
# Google OAuth client IDs.  Create separate Web and Desktop clients in Google Cloud.
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-desktop-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_WEB=your-web-client-id.apps.googleusercontent.com
ENVIRONMENT=production

# ===== Logging =====
LOG_LEVEL=info
LOG_FORMAT=json

# ===== Ports =====
BACKEND_PORT=5000
AI_PORT=5001
SYNC_PORT=5002
SCHEDULER_PORT=5003
OLLAMA_PORT=11434
NGINX_PORT=80
NGINX_SSL_PORT=443
PROMETHEUS_PORT=9090
DB_PORT=5432

# ===== AI Configuration =====
OLLAMA_ENDPOINT=http://ollama:11434
DEFAULT_MODEL=deepseek-r1:14b
PHALA_AI_API_KEY=your-phala-confidential-ai-api-key
PHALA_AI_MODEL=deepseek/deepseek-v4-flash

# ===== Controlled Wallet V2 (Base Sepolia testnet only) =====
# Treat namespace + derivation version as permanent after any address is funded.
WALLET_NAMESPACE=todoapp-wallet
WALLET_DERIVATION_VERSION=v1
WALLET_CHAIN_ID=84532
WALLET_CHAIN_NAME=Base Sepolia
WALLET_NATIVE_SYMBOL=ETH
WALLET_RPC_URL=https://sepolia.base.org
WALLET_EXPLORER_API_URL=https://base-sepolia.blockscout.com/api/v2
WALLET_EXPLORER_URL=https://base-sepolia.blockscout.com
WALLET_SEND_ENABLED=true
WALLET_MAX_TRANSFER_ETH=0.1
WALLET_DAILY_LIMIT_ETH=0.25
WALLET_MAX_FEE_GWEI=5
WALLET_QUOTE_TTL_SECONDS=600
WALLET_PREPARE_LIMIT_PER_HOUR=10

# XP/milestones work with badge minting disabled. See REWARDS.md before enabling.
REWARD_XP_PER_TASK=10
REWARD_XP_PER_LEVEL=50
REWARD_BADGES_ENABLED=false
REWARD_BADGE_CONTRACT_ADDRESS=
REWARD_MAX_GAS=200000

# ===== OpenClaw Confidential AI =====
# Enable only after PHALA_AI_API_KEY has been added to the secure environment.
OPENCLAW_CONFIDENTIAL_AI_ENABLED=false
OPENCLAW_CONFIDENTIAL_AI_BASE_URL=https://inference.phala.com/v1
OPENCLAW_CONFIDENTIAL_AI_MODEL=deepseek/deepseek-v4-flash
OPENCLAW_CONFIDENTIAL_AI_ALIAS=Phala Confidential
OPENCLAW_CONFIDENTIAL_AI_TIMEOUT_SECONDS=300

# ===== Clawdi Cloud Connector =====
# Keep false until the one-time interactive login/setup is complete.
# See CLAWDI_CLOUD.md. Clawdi credentials persist in the clawdi_data volume.
CLAWDI_ENABLED=false

# ===== TLS/SSL (for production) =====
# Set to true and provide cert paths for HTTPS
ENABLE_TLS=false
TLS_CERT_PATH=/etc/nginx/certs/cert.pem
TLS_KEY_PATH=/etc/nginx/certs/key.pem

# ===== Phala CVM Specific =====
# These are set by Phala CVM when deployed
CVM_CHAIN=phala-testnet
CVM_MEMORY_MB=2048
CVM_CPU_CORES=2

# ===== Monitoring =====
PROMETHEUS_SCRAPE_INTERVAL=15s
METRICS_ENABLED=true

# ===== Backup =====
BACKUP_ENABLED=true
BACKUP_INTERVAL_DAYS=7
BACKUP_RETENTION_DAYS=30

# ===== Rate Limiting =====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=100

# ===== CORS Configuration =====
CORS_ALLOWED_ORIGINS=http://localhost:*,https://*.phala.network
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-API-Key

# ===== Email Notifications (optional) =====
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=kylenguyen1206@gmail.com
# Create a Google App Password for this Gmail account; never use your normal password.
SMTP_PASSWORD=your-16-character-google-app-password

# ===== Webhook Configuration (optional) =====
WEBHOOK_ENABLED=true
WEBHOOK_TIMEOUT_SECONDS=30
WEBHOOK_RETRY_COUNT=3

# ===== Storage Configuration =====
MAX_STORAGE_MB=10000
STORAGE_PATH=/app/data

# ===== Cache Configuration =====
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE_MB=500

# ===== Performance Tuning =====
MAX_WORKERS=4
MAX_CONNECTIONS=20
CONNECTION_TIMEOUT_SECONDS=30
QUERY_TIMEOUT_SECONDS=60

# ===== Development/Testing =====
# Only set to true for local development
DEBUG_MODE=false
TEST_MODE=false
MOCK_AI_RESPONSES=false
